# Copy to backend/.env (gitignored, never uploaded) and fill in the blanks.
# Values marked PUBLIC are safe to share; everything marked SECRET must never be committed or pasted in chat.

# ===== Deployment (deploy/hf_space.py reads this file) ==========================================================
# SECRET. Hugging Face → Settings → Access Tokens → Create new token → type "Write".
HF_TOKEN=
# Your Space, as <hf-username>/<space-name>
HF_SPACE=your-hf-username/machine-sound-monitor

# ===== Accounts & data (Supabase project "machine-sound-monitor") ===============================================
# PUBLIC: project URL and publishable key (also used by the sign-in page in the browser).
SUPABASE_URL=https://ysgorgepbxvbxbsdgiat.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_CWeRxFWFcybmHCWrlxDqOA_JVTEHobx
# SECRET. Supabase dashboard → Connect (top bar) → "Session pooler" → copy the URI, and put the database password
# in place of [YOUR-PASSWORD] (Project Settings → Database → Reset database password if you don't know it).
# Use the SESSION POOLER string (port 5432, host ...pooler.supabase.com): the direct host is IPv6-only.
# Leave empty to use the local SQLite file below instead (data is then lost when a free host restarts).
DATABASE_URL=
DB_PATH=data/monitor.db

# ===== Detector =================================================================================================
# heuristic = dev scorer (no trained model, labelled as such in the UI); autoencoder = trained checkpoint;
# embedding = pretrained PANNs CNN14 + distance to an enrolled healthy profile (python -m ml.embed_eval enroll)
SCORER=heuristic
MODEL_PATH=models/fan_01.pt
EMBEDDING_PROFILE=models/fan_01_emb.npz
PANNS_CHECKPOINT=models/panns/Cnn14_16k_mAP=0.438.pth
# off | flag. flag = mark windows with speech (Silero VAD) or sudden impacts; never changes scores or alerts
INTERFERENCE=off

# ===== Web ======================================================================================================
# Comma-separated origins allowed to call the API (the deployed app URL in production)
CORS_ORIGINS=http://localhost:5173
# Used in alert messages and the links printed by the admin CLI
PUBLIC_APP_URL=http://localhost:5173

# ===== Alerts (optional) ========================================================================================
# SECRET. E-mail alerts via Resend: resend.com → API Keys → Create API key (permission "Sending access").
RESEND_API_KEY=
# Sender. Without your own domain verified in Resend, keep onboarding@resend.dev: it then only delivers to the
# e-mail address you signed up to Resend with (fine for the demo). With a verified domain: alerts@yourdomain.com
EMAIL_FROM=Machine Sound Monitor <onboarding@resend.dev>
